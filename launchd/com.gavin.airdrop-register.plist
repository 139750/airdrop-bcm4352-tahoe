<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.gavin.airdrop-register</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/gavin/.venv-opendrop/bin/python</string>
        <string>/Users/gavin/.hermes/scripts/airdrop_register.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>20</integer>
    <key>StandardOutPath</key>
    <string>/tmp/airdrop_register.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/airdrop_register.err</string>
</dict>
</plist>
